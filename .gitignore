# 一键复现验收脚本的运行产物（脚本可随时重跑生成，不入库；人工整理的报告见 docs/）
backend/scripts/bench/reports/

# 评估数据集与报告产物：题面与金标答案逐字来自甲方表格（真实客户问答），绝不入库。
# reports/ final/ synthetic/ 三个目录只放产物、不含脚本，整目录忽略（工具脚本放在
# eval_datasets/ 根目录，那里按扩展名排除数据、保留 .py）。
backend/scripts/eval_datasets/reports/
backend/scripts/eval_datasets/final/
backend/scripts/eval_datasets/synthetic/
backend/scripts/eval_datasets/*.jsonl
backend/scripts/eval_datasets/*.json
backend/scripts/eval_datasets/*.csv
backend/scripts/eval_datasets/*.xlsx
backend/scripts/eval_datasets/*.md
backend/scripts/eval_datasets/*.zip
# 例外提醒：该脚本把甲方 100 题验证集以字面量写死（等同数据集本身），已移出仓库，
# 本地保留。此处显式忽略，避免日后被 git add 带回。
backend/scripts/eval_datasets/build_validation_datasets.py
# 甲方业务问答清单（100 题，逐条为真实业务问题并标注知识库归属）
docs/知识库问答验收测试问题清单-*.md

# docker 运行时数据备份（数据库/模型目录，绝不入库）
docker/_bak-*/
docker/volumes.pre-restore-*/

# 甲方提供的原始资料（表格/文档/压缩包，含真实业务数据，绝不入库）
# 整个「流程图-word方案案例」目录都是甲方材料（流程图重建的 md/mmd/渲染图 + word
# 方案样例 + 白皮书 + 压缩包），按目录整体忽略——只按扩展名拦会漏掉 png/mmd/md。
docs/流程图-word方案案例/
# 其余甲方资料按扩展名拦，用 docs/**/ 覆盖各层子目录
# （docs/**/x 同时匹配 docs/x 与 docs/a/b/x）
docs/**/*.xlsx
docs/**/*.xls
docs/**/*.doc
docs/**/*.docx
docs/**/*.zip
docs/**/*.rar

# 配置改动前的备份副本（准备改 docker-compose/nginx 时留下的 .repo 快照，正式文件才是要保留的版本）
*.repo
