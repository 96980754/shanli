# 首装初始账号：正常路径是首次打开网页时的「初始化管理员」引导（空库时自动出现），
# 无需在此配置。以下三项仅供 make seed 在空库上批量建号时读取——脚本不含内置凭据，
# 缺任一项即报错退出。注意二者只能选其一：执行过 seed 后 users 表非空，网页端的
# 初始化引导会返回 403。
# 密码生成：openssl rand -hex 16
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_UID=
# YUXI_SUPER_ADMIN_PASSWORD=

# 仅供 make seed-demo（示例部门与人员：3 部门 + 6 管理员 + 14 普通用户）使用的共用密码，
# 生产环境不要设置，也不要与超管密码相同。
# YUXI_DEMO_USER_PASSWORD=

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# Enterprise WeChat self-built application callback (P0)
# Configure the callback URL as https://YOUR_DOMAIN/api/wecom/callback.
# The local system account UID must equal the Enterprise WeChat UserID.
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=
# WECOM_CORP_ID=
# Enterprise WeChat Customer Service: create one or more customer-service accounts, then copy
# their "Enterprise WeChat App/Web access" customer-service URLs here. First-boot default only;
# the admin Basic-settings UI is authoritative once saved. Multiple URLs (newline/comma separated)
# are used in rotation for refusal handoff.
# WECOM_CUSTOMER_SERVICE_URL=https://work.weixin.qq.com/kf/...

# Udesk 客服系统对接（知识回流：定时拉取客服对话记录 → 总结候选问答 → 人工审核入库）。
# open_api_token 是永久凭证（不会自动过期），可在设置页「Udesk 对接」填写（只写不读，
# 接口不回显明文）；获取路径：Udesk「账户设置 → 安全设置 → 鉴权Token」，须超级管理员账号。
# 全部参数（开关/子域名/账号/Token/重叠窗/回灌天数）均可设置页自助配置、保存即热生效，
# 此处仅作部署时初始默认值，设置页优先。
# UDESK_ENABLED=false
# UDESK_SUBDOMAIN=              # 例如 1866890.s2（即 https://<subdomain>.udesk.cn）
# UDESK_EMAIL=                  # 超级管理员邮箱（普通坐席无效）
# UDESK_OPEN_API_TOKEN=         # 鉴权 Token（永久凭证，按密钥保管；设置页填写优先）
# UDESK_RATE_LIMIT_PER_MIN=24   # 全局匀速间隔 2.5s（对话记录接口各端点限 1 次/2 秒）
# UDESK_REQUEST_TIMEOUT_SECONDS=15
# UDESK_MAX_RETRIES=2
# UDESK_SYNC_OVERLAP_MINUTES=10   # 增量重叠窗：起点=游标-重叠分钟数，边界漏读由唯一键吸收
# UDESK_BACKFILL_START_DAYS=30    # 首次拉取回灌天数；接口只提供一个月内数据，上限 30

# # PaddleOCR API（也可在管理端「设置 - 外部服务」自助填写：设置页有值即优先使用，此处仅作初始默认值）
# PADDLEOCR_API_TOKEN=
# PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: memory | docker | kubernetes
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 注意：网络名称已在 docker-compose.yml 中固定为 yuxi-know_app-network
# SANDBOX_DOCKER_NETWORK=yuxi-know_app-network
# SANDBOX_DOCKER_THREADS_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox
# SANDBOX_DOCKER_SANDBOX_HOST=host.docker.internal

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=yuxi-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=yuxi-thread
# SKILLS_PVC=yuxi-skills  # 当前代码会读取，但 Pod 挂载实际仍只使用 THREAD_PVC

# 产品图片本地型号识别（Ultralytics YOLO best.pt，可选功能）
# auto＝容器内存在权重文件即启用；1/0 强制开关。权重放宿主 docker/volumes/models/（已 gitignore）
PRODUCT_DETECT_ENABLED=auto
PRODUCT_DETECT_MODEL_PATH=/app/models/best.pt
PRODUCT_DETECT_CONF=0.5
PRODUCT_DETECT_IMGSZ=640
