# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
# 获取搜索服务的 api key 请访问 https://app.tavily.com/
# 也可在管理端「设置 - 外部服务」自助填写：设置页有值即优先使用，此处仅作初始默认值
TAVILY_API_KEY=

# JWT 安全配置。生产部署必须在 .env.prod 中手工填写持久化随机值：
#   openssl rand -hex 32  → JWT_SECRET_KEY
#   openssl rand -hex 8   → YUXI_INSTANCE_ID
# 留空不会自动生成：生产环境下服务能正常启动、健康检查也通过，但首次登录/校验
# 即抛 ValueError（没有初始化脚本会代填）。开发环境留空会自动生成临时值，
# 但只存内存：重启即更换，已有登录态全部失效。
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# YUXI_ENV 不在本文件配置：docker-compose.yml 固定 development，
# docker-compose.prod.yml 固定 production（compose 的 environment 优先于 env_file）。
# YUXI_ENV=development

# 对象存储（MinIO）凭据。同名变量被两处读取：minio 服务用作根凭据、Milvus 用它访问
# MinIO，且都经 docker-compose 的 ${MINIO_ACCESS_KEY} 插值取值——而**插值只读项目目录
# 的 .env 或 --env-file 指定的文件，不读 env_file**。所以生产启动必须带
# `--env-file .env.prod`（见 docs/advanced/deployment.md），否则 Milvus 拿到空串、
# MinIO 退到默认 minioadmin，两边不一致会导致向量库无法访问对象存储。
# 生产部署必须改为强随机值。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

