flowchart TD
  subgraph CUST["客服"]
    S1["客服输出需求"]
  end

  subgraph SALES["销售/销售总监"]
    S3["销售提供项目信息"]
  end

  subgraph PDM["产品总监"]
    D3_eval{"产品总监评估通过?"}
    D4_eval{"产品总监评估通过?"}
  end

  subgraph DELIVERY["交付"]
    S3_delivery["交付核算/审批"]
    S4_delivery["交付部门确认"]
    S8["交付部门按发货流程发货"]
  end

  subgraph SGM["销售总经理"]
    S3_b["上级审批（销售总经理权限）"]
    S4_high["销售总经理权限审批"]
  end

  subgraph PURCHASE["采购"]
    S7["询价比价、供应商审核/建档"]
    S7p["发起采购：采购引入、入库、确认交期"]
  end

  %% 存疑：OCR“顶首”疑似“预算”，无法完全确认
  S2b["输出方案、预算及标准化产品清单"]
  %% 存疑：需求评估“通过/不通过”与“标准化/非标准化”对应关系因OCR断裂，按上下文推断
  D2{"需求评估通过?"}
  %% 存疑：原文“联康标准化产品”疑似“联想”，语义不明确
  D3_product{"产品类型/是否涉及交付?"}
  %% 存疑：“酸工”疑似“竣工”，无法确认
  S8r["生成验收报告/竣工报告"]

  D1{"线索有效?"}
  E1["不进入商机"]
  S2a["进入商机，执行需求评估流程"]
  S2d["补充：需求评估决策人：研发、交付、销售、行销、产品经理、产品运营、高级供应链"]
  S3p["发起报价审批"]
  D3_a{"是否超权限?"}
  D3_cond{"满足直接引用解决方案清单、报价审批一致；价格政策内，现款现货?"}
  S3_confirm["确认报价"]
  S3_reapply["重新发起审批/超权限审批"]
  D3_result{"审批同意?"}
  E3_fail["报价不通过/流程终止"]
  S4["确认合同方案"]
  D4_product{"产品类型/是否涉及交付?"}
  S4_standard["按标准合同确认"]
  D4_perm{"是否超权限?"}
  D4_result{"审批同意?"}
  E4_fail["流程终止/返回调整"]
  S4_done["合同盖章、合同归档"]
  S5["召开需求澄清会"]
  D5{"产品类型?"}
  S5n1["定制化开发"]
  S5n2["输出需求"]
  S5n3["开发解决方案"]
  S5n4["开发完成入库（账号、终端类，库存）"]
  S5s1["输出需求"]
  S5s2["进入交付准备"]
  S6["进行需求评估/制定实施计划"]
  D6{"实施方式?"}
  D7{"库存满足?"}
  S9["完成验收，验收报告归档"]

  S3d["补充：项目背景、项目申请价格、价格策略、竞品分析、付款方式、项目风险等"]
  S5d["补充：参会人员：销售、销售运营、产品运营、交付经理及项目交付相关人员"]
  S7d["补充：采购/审批通过OA流程发起，库存与交付信息通过云星空同步"]

  S1 --> D1
  D1 -- "有效" --> S2a
  D1 -- "无效" --> E1
  S2a --> S2b
  S2b --> D2
  D2 -- "通过/标准化" --> S3
  D2 -- "不通过/非标准化" --> S3
  S3 --> S3p
  S3p --> D3_product
  D3_product -- "标准化且涉及交付" --> S3_delivery
  S3_delivery --> D3_a
  D3_product -- "非标准化" --> D3_eval
  D3_eval -- "通过" --> D3_a
  D3_eval -- "不通过" --> E3_fail
  D3_a -- "超权限" --> S3_b
  D3_a -- "权限内" --> D3_cond
  S3_b --> D3_result
  D3_cond -- "满足：直接引用解决方案清单、报价审批一致；价格政策内，现款现货" --> S3_confirm
  D3_cond -- "不满足：引用报价解决方案清单但报价有变" --> S3_reapply
  S3_reapply --> S3_b
  D3_result -- "同意" --> S3_confirm
  D3_result -- "不同意" --> E3_fail
  S3_confirm --> S4
  S4 --> D4_product
  D4_product -- "标准化不涉及交付" --> S4_standard
  S4_standard --> D4_perm
  D4_product -- "标准化涉及交付" --> S4_delivery
  S4_delivery --> D4_perm
  D4_product -- "非标准化" --> D4_eval
  D4_eval -- "通过" --> D4_perm
  D4_eval -- "不通过" --> E4_fail
  D4_perm -- "超权限" --> S4_high
  S4_high --> D4_result
  D4_perm -- "权限内" --> D4_result
  D4_result -- "同意" --> S4_done
  D4_result -- "不同意" --> E4_fail
  S4_done --> S5
  S5 --> D5
  D5 -- "非标准化" --> S5n1
  S5n1 --> S5n2 --> S5n3 --> S5n4 --> S6
  D5 -- "标准化" --> S5s1 --> S5s2 --> S6
  S6 --> D6
  D6 -- "自行实施" --> S7
  D6 -- "外包实施" --> S7
  S7 --> D7
  D7 -- "满足" --> S8
  D7 -- "不满足" --> S7p
  S7p --> S8
  S8 --> S8r --> S9

  S2a -.-> S2d
  S3 -.-> S3d
  S5 -.-> S5d
  S7 -.-> S7d

  %% 存疑：角色“产品总经理”“董事长”未在OCR文本中明确对应审批节点，未归入流程
